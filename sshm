#!/usr/bin/env bash

set -e

CONFIG="${HOME}/.ssh/config"

if [ ! -f "$CONFIG" ]; then
  echo "No SSH config found at $CONFIG"
  exit 1
fi

if ! command -v gum >/dev/null 2>&1; then
  echo "gum is required. Install with: brew install gum"
  exit 1
fi

BOLD='\033[1m'
RESET='\033[0m'
ESC=$'\033'
RESULT=""

# Host line format:
#   Host name                      -> root-level host
#   Host category name             -> host inside category
#   Host category inner_cat name   -> host inside category > inner_cat
# Last word is the SSH alias. Hosts whose last word starts with _ are hidden.
HOSTS_DATA=$(awk '
/^Host / {
  count = NF - 1
  if (count == 0) next
  name = $NF
  if (name ~ /\*/ || name ~ /^_/) next
  cat   = (count >= 2) ? $2 : ""
  inner = (count >= 3) ? $3 : ""
  printf "%s|%s|%s\n", name, cat, inner
}
' "$CONFIG")

if [[ -z "$HOSTS_DATA" ]]; then
  echo "No SSH hosts found."
  exit 1
fi

show_menu() {
  local cat_filter="$1"
  local inner_filter="$2"

  local menu_items=()
  local seen_subcats=()
  local found s

  while IFS='|' read -r host cat inner; do
    [[ -z "$host" ]] && continue

    if [[ -z "$cat_filter" ]]; then
      if [[ -n "$cat" ]]; then
        found=0
        for s in "${seen_subcats[@]}"; do [[ "$s" == "$cat" ]] && found=1 && break; done
        [[ $found -eq 0 ]] && seen_subcats+=("$cat")
      else
        menu_items+=("$host")
      fi
    elif [[ "$cat" == "$cat_filter" && -z "$inner_filter" ]]; then
      if [[ -n "$inner" ]]; then
        found=0
        for s in "${seen_subcats[@]}"; do [[ "$s" == "$inner" ]] && found=1 && break; done
        [[ $found -eq 0 ]] && seen_subcats+=("$inner")
      else
        menu_items+=("$host")
      fi
    elif [[ "$cat" == "$cat_filter" && "$inner" == "$inner_filter" ]]; then
      menu_items+=("$host")
    fi
  done <<< "$HOSTS_DATA"

  for s in "${seen_subcats[@]}"; do
    menu_items+=("$(printf "${BOLD}▶ %s${RESET}" "$s")")
  done
  [[ -n "$cat_filter" ]] && menu_items+=("← Back")

  local header
  if [[ -n "$inner_filter" ]]; then
    header="$(printf "${BOLD}%s › %s${RESET}" "$cat_filter" "$inner_filter")"
  elif [[ -n "$cat_filter" ]]; then
    header="$(printf "${BOLD}%s${RESET}" "$cat_filter") — select host"
  else
    header="Select SSH host"
  fi

  while true; do
    local selected
    selected=$(printf '%s\n' "${menu_items[@]}" | gum choose --header "$header" || true)

    [[ -z "$selected" || "$selected" == "← Back" ]] && RESULT="" && return 0

    local clean
    clean=$(printf '%s' "$selected" | sed "s/${ESC}\[[0-9;]*m//g")

    if [[ "$clean" == "▶ "* ]]; then
      local subname="${clean#▶ }"
      if [[ -z "$cat_filter" ]]; then
        show_menu "$subname" ""
      else
        show_menu "$cat_filter" "$subname"
      fi
      [[ -n "$RESULT" ]] && return 0
    else
      RESULT="$clean"
      return 0
    fi
  done
}

show_menu "" ""
[[ -z "$RESULT" ]] && exit 0
ssh "$RESULT"
